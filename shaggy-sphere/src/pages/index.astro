---
import "../styles/global.css";
---

<html>
  <head>
	<meta charset="UTF-8" />
    <title>Empanadas Porteñas</title>
  </head>

  <body class="bg-orange-50 text-gray-800">

    <!-- HEADER -->
    <header class="bg-red-800 text-white text-center p-6">
      <h1 class="text-3xl font-bold"> Empanadas Porteñas</h1>
      <p class="text-sm">Las mejores empanadas caseras</p>
    </header>

    <!-- NAV -->
    <nav class="bg-red-600 text-white flex justify-center gap-6 p-4">
      <a href="#nosotros" class="hover:underline">Nosotros</a>
      <a href="#menu" class="hover:underline">Menú</a>
      <a href="#contacto" class="hover:underline">Contacto</a>
    </nav>

    <!-- SECCIÓN 1 -->
    <section id="nosotros" class="p-6 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-2">Sobre nosotros</h2>
	  <img src="../../public/familia_empanadas.jpg" alt="Familia :P"/>
      <p>
        Somos un local familiar dedicado a hacer empanadas artesanales con ingredientes frescos y recetas tradicionales.
      </p>
    </section>

    <!-- SECCIÓN 2 -->
    <section id="menu" class="p-6 bg-white max-w-3xl mx-auto rounded-xl shadow">
      <h2 class="text-2xl font-bold mb-4">Menú</h2>

      <ul class="space-y-2">
        <li class="cursor-pointer clase carne"> Carne</li>
        <li class="cursor-pointer clase pollo"> Pollo</li>
        <li class="cursor-pointer clase jyq"> Jamón y queso</li>
        <li class="cursor-pointer clase humita"> Humita</li>
      </ul>
	  <div class="mimi"></div>

      <button 
        onclick="verPromo()" 
        class="mt-4 bg-red-700 text-white px-4 py-2 rounded hover:bg-red-900"
      >
        Ver promoción
      </button>
    </section>

    <!-- SECCIÓN 3 -->
    <section id="contacto" class="p-6 max-w-3xl mx-auto">
      <h2 class="text-2xl font-bold mb-2">Contacto</h2>
      <p> Dirección: Calle Falsa 123</p>
      <p> Teléfono: 1234-5678</p>
    </section>

    <script>
      function verPromo() {
        alert(" Promo: 12 empanadas al precio de 10!");
      }
	  document.querySelectorAll('.clase').forEach((emp) =>{
		emp.addEventListener('click', ()=>{
			const imgChanger = document.querySelector('.mimi');
			if (emp.classList.contains('pollo')){
				imgChanger.innerHTML = `<img src="../../public/pollo.jpg" alt="empPollo" class="z-100 -mt-30 absolute"/>`;
			} else{
				imgChanger.innerHTML = '';
			}
		})
	  })
    </script>

  </body>
</html>